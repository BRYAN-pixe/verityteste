<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" style="-fx-background-image: url('/com/mycompany/jogo/reserva.png'); -fx-background-size: cover; -fx-background-position: center; -fx-background-repeat: no-repeat;"
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.PrimaryController">
    
         
<Label text="Forgeiro" />
      <Button text="Novo jogo" onAction="#switchToSecondary" style="-fx-background-color: black; -fx-text-fill: white; -fx-font-size: 14px;" />
      <Button text="Ranking" onAction="#switchToSecondary"/>
      <Button text="Creditos" onAction="#switchToSecondary"/>
      <Button text="sair" onAction="#switchToSecondary"/>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
