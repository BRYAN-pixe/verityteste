<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox alignment="CENTER" spacing="0" style="-fx-background-image: url('/com/mycompany/jogo/satanas.png'); -fx-background-size: cover; -fx-background-position: center; -fx-background-repeat: no-repeat;"
      xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.PrimaryController">
   
         <stylesheets>
    <URL value="@style.css"/>
</stylesheets>
    
    
    
    
   <VBox spacing="22.0" alignment="CENTER_LEFT"
      style="-fx-padding: 35;">

    <Label text="MINING MASTER"
           styleClass="game-title"/>

    <Label text="Feito por: Bryan e Murilo."
           styleClass="game-subtitle"/>

    <Region prefHeight="20"/>

    <Button text="NOVO JOGO"
            onAction="#switchToSecondary"
            styleClass="menu-button"/>

    <Button text="EQUIPAMENTOS"
            onAction="#switchToSecondary"
            styleClass="menu-button"/>

    <Button text="MINÉRIOS"
            onAction="#switchToSecondary"
            styleClass="menu-button"/>

    <Button text="CAVERNAS"
            onAction="#switchToSecondary"
            styleClass="menu-button"/>

</VBox>
      <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
