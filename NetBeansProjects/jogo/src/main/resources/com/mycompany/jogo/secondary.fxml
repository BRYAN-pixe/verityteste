<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<VBox  spacing="10.0"  xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.jogo.SecondaryController"
      style="-fx-background-image: url('/com/mycompany/jogo/lobby.png'); -fx-background-size: cover;
-fx-background-position: center center;
-fx-background-repeat: no-repeat;">
    
    <stylesheets>
    <URL value="@style.css"/>
</stylesheets>

             
   
     <VBox spacing="10.0" alignment="TOP_CENTER"
      style="-fx-padding: 35;">

             <Label text="NOVO FORGEIRO"
           styleClass="forgeiro"/>
         </VBox>
         <HBox spacing="700.0" alignment="CENTER">
         <VBox spacing="10.0" alignment="CENTER_LEFT"
      style="-fx-padding: 35;">

             <Label text="NOME"
           styleClass="car"/>
         </VBox>
          <VBox spacing="10.0" alignment="CENTER_RIGHT"
      style="-fx-padding: 35;">

             <Label text="CLASSE"
           styleClass="car"/>
         </VBox>
         </HBox>
         
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
</VBox>
